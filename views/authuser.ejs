<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TLE Parts Assistant</title>
    <!-- <link rel="stylesheet" href="authuser.css"> -->
    <link rel="stylesheet" href="a.css">
</head>

<body>
    <header>
        <h2>Enter a part manufacturer and part number to retrieve the following information</h2>
        <span style="margin-left: 1em;text-decoration: double;">Details</span>
        <ul>
            <div class="li-grp">
                <li>Description</li>
                <li>Type</li>
                <li>Specs</li>
                <li>Compatibility</li>
            </div>
            <div class="li-grp">
                <li>Dimensions</li>
                <li>Replacement / Equivalent</li>
                <li>Installation Notes</li>
            </div>
        </ul>
    </header>
    <main>
        <div class="spans">
            <span class="span-1">Parts Finder</span>
            <span class="span-2">Sales Assistant</span>

        </div>
        <section class="tool-1">
            <form class="manu-id">
                <p>Search for a part by manufacturer and part id</p>
                <p>• FIND PART NUMBER</p>
                <span style="padding: 2px 4px;color: #00e5ff; font-weight: bolder; border: 1px solid silver;border-radius: 999px">search part name</span>
                <div class="form-grp" style="margin-top: 1em;">
                    <label for="manufacturer">
                        Manufacturer
                    </label>
                    <input type="text" id="manufacturer" placeholder="eg: clipsal">
                </div>
                <div class="form-grp">
                    <label for="part-id">
                        Part Num/ID
                    </label>
                    <input type="text" id="part-id" placeholder="eg: mx9m322pg">
                </div>

                <input id="submit" type="submit" style="margin-top: 10px;" value="Search">
            </form>

            <form class="part-name">
                <p>Search for a part by name or description</p>
                <p>• FIND PART NAME</p>
                <span style="padding: 2px 4px;color: #00e5ff; font-weight: bolder; border: 1px solid silver;border-radius: 999px;">search product number</span>
                <div class="form-grp" style="margin-top: 1em;">
                    <label for="part-name">
                        Part Name
                    </label>
                    <input type="text" id="part-name" placeholder="eg: clipsal ip62 double wall outlet">
                </div>

                <input id="submit" type="submit" value="Search">
            </form>
        </section>

        <section class="tool-2">
            <form class="sales-assistant">
                <p>Find top five buiding sites that have a high probablity of purchasing the below electrical parts.</p>
                <div class="form-grp" style="margin-top: 1em;">
                    <label for="sales-name">
                        Part Name
                    </label>
                    <input type="text" id="sales-name" placeholder="eg: clipsal 180/32">
                </div>
                <div class="form-grp">
                    <label for="sales-area">
                        Area
                    </label>
                    <input type="text" id="sales-area" placeholder="eg: all Sydney metro">
                </div>

                <input id="submit" type="submit" value="Search">
            </form>
        </section>

        <hr>

        <section class="response">
            <span>Response:</span>
            <span class="clr-btn">Clear</span>
            <div class="output">
                <textarea name="output" id="output" cols="31" rows="7"></textarea>
            </div>
        </section>
    </main>
    <footer style="margin-top: 2em;">EmTechProjects&nbsp;2026</footer>


    <script src="authuser.js"></script>
</body>

</html>