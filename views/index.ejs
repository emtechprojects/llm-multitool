<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Express Sqlite3 Gemini Framework</title>
    <link rel="stylesheet" href="index.css">

</head>

<body>
    <main>
        <form class="login-form">
            <h1>Enter your username and password.</h1>
            <span>SIGN UP FORM</span>
            <div class="grp">
                <label for="login-name">User Name</label>
                <input type="text" name="login-name" id="login-name" min="2" max="6" value="tle-admin">
            </div>
            <div class="grp">
                <label for="login-pw">Enter Password</label>
                <input type="password" name="login-pw" id="login-pw" min="2" max="6" required>
            </div>
            <input type="submit" value="Login">
        </form>
        <form class="signup-form">
            <h1>Create a username and password.</h1>
            <span>LOG IN FORM</span>
            <div class="grp">
                <label for="signup-name">User Name</label>
                <input type="text" name="signup-name" id="signup-name" min="2" max="6" value="tle-admin">
            </div>
            <div class="grp">
                <label for="signup-pw">Enter Password</label>
                <input type="password" name="signup-pw" id="signup-pw" min="2" max="6" required>
            </div>
            <input type="submit" value="Sign Up">
        </form>
    </main>
    <footer style="margin-top: 2em;">EmTechProjects&nbsp;2026</footer>

    <script src="index.js"></script>
</body>

</html>